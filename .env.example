# HAKIM Ω — Environment Configuration
# Never commit real secrets to Git.
# AI provider credentials are server-side only.
GEMINI_API_KEY=
GROQ_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
OPENROUTER_API_KEY=
LOCAL_AI_URL=

# Microsoft Entra ID / Microsoft 365 enterprise identity
# Public client ID; safe to expose in SPA configuration.
MICROSOFT_CLIENT_ID=
# Use organizations for work/school accounts, or a specific tenant for a single ministry tenant.
MICROSOFT_TENANT_ID=organizations
# Optional comma-separated tenant allowlist for institutional deployment.
MICROSOFT_ALLOWED_TENANTS=
# Backend application settings when server-side Graph/OBO is enabled.
MICROSOFT_CLIENT_SECRET=
MICROSOFT_GRAPH_SCOPES=User.Read
